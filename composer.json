{
    "name": "alengo/sulu-contact-account-extra-bundle",
    "description": "Additional Data tab for Sulu CMS Contacts and Accounts — generic JSON field with configurable forms",
    "type": "symfony-bundle",
    "homepage": "https://github.com/alengodev/SuluContactAccountExtraBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Huber-De Monte"
        }
    ],
    "require": {
        "php": "^8.2",
        "sulu/sulu": "~3.0"
    },
    "autoload": {
        "psr-4": {
            "Alengo\\SuluContactAccountExtraBundle\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": true
        }
    }
}
